<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PyxelSharp</RootNamespace>
    <!-- NuGet package metadata (local feed distribution; see docs/TODO.md Stage 4) -->
    <PackageId>PyxelSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>clayAndromeda</Authors>
    <Description>C# binding for the Pyxel retro game engine (bundles pyxel-core v2.9.8, win-x64 native included).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/clayAndromeda/pyxel-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/clayAndromeda/pyxel-sharp</RepositoryUrl>
    <PackageTags>pyxel;game;gamedev;retro</PackageTags>
    <RustCrateDir>$(MSBuildThisFileDirectory)..\..\..\rust\pyxel-bind-cs\</RustCrateDir>
    <RustProfile>release</RustProfile>
    <RustDll>$(RustCrateDir)target\$(RustProfile)\pyxel_bind_cs.dll</RustDll>
    <!-- Falls back to the default LLVM install location when the env var is not set -->
    <LibClangPath Condition="'$(LIBCLANG_PATH)' != ''">$(LIBCLANG_PATH)</LibClangPath>
    <LibClangPath Condition="'$(LibClangPath)' == ''">C:\Program Files\LLVM\lib</LibClangPath>
  </PropertyGroup>

  <!-- Builds pyxel_bind_cs.dll (which also regenerates NativeMethods.g.cs) and
       copies it next to the managed output. Set SkipRustBuild=true when the DLL
       is already built (e.g. sandboxed CI steps) or not needed at all
       (browser-wasm links the staticlib instead; see PyxelSharp.Web.props). -->
  <Target Name="BuildRustBinding" BeforeTargets="AssignTargetPaths">
    <Exec Condition="'$(SkipRustBuild)' != 'true'"
          Command="cargo build --$(RustProfile) --features sdl2_static"
          WorkingDirectory="$(RustCrateDir)"
          EnvironmentVariables="LIBCLANG_PATH=$(LibClangPath)" />
    <Error Condition="'$(SkipRustBuild)' != 'true' and !Exists('$(RustDll)')"
           Text="pyxel_bind_cs.dll not found at $(RustDll). Run 'cargo build --release --features sdl2_static' in rust/pyxel-bind-cs first." />
    <ItemGroup Condition="Exists('$(RustDll)')">
      <None Include="$(RustDll)" CopyToOutputDirectory="PreserveNewest" Visible="false"
            Pack="true" PackagePath="runtimes/win-x64/native/" />
    </ItemGroup>
  </Target>

</Project>
