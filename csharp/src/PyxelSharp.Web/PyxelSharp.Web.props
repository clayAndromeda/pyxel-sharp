<!-- Shared build configuration for PyxelSharp browser-wasm samples/games.
     Import from a Microsoft.NET.Sdk.WebAssembly project:

       <Import Project="..\..\src\PyxelSharp.Web\PyxelSharp.Web.props" />

     Prerequisites and the full recipe live in docs/WEB_DESIGN.md;
     tools/Build-Wasm.ps1 drives the whole build. -->
<Project>

  <PropertyGroup>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- emsdk root (must match the emscripten bundled with the .NET
         workload; see docs/WEB_DESIGN.md). Defaults to the EMSDK env var
         set by emsdk_env; tools/Build-Wasm.ps1 handles this. -->
    <EmsdkRoot Condition="'$(EmsdkRoot)' == ''">$(EMSDK)</EmsdkRoot>
    <!-- emcc response files require forward slashes -->
    <_EmsdkSysrootLib>$([System.String]::Copy('$(EmsdkRoot)').Replace('\','/'))/upstream/emscripten/cache/sysroot/lib/wasm32-emscripten</_EmsdkSysrootLib>
    <!-- Link the SDL2 port prebuilt by emsdk (-sUSE_SDL=2 would try to build
         the port inside the read-only dotnet pack cache) -->
    <EmccExtraLDFlags>-L$(_EmsdkSysrootLib) -lSDL2 -lhtml5 -sALLOW_MEMORY_GROWTH=1</EmccExtraLDFlags>

    <!-- TEMPORARY (remove when the .NET workload ships a newer emscripten):
         Rust nightly LLVM records feature names (bulk-memory-opt etc.) that
         emscripten 3.1.56's wasm-opt rejects, so skip binaryen entirely. -->
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>

    <!-- Rust staticlib staged by tools/Build-Wasm.ps1 (renamed from
         libpyxel_bind_cs.a so the stem matches DllImport("pyxel_bind_cs")) -->
    <PyxelSharpWebStaticLib Condition="'$(PyxelSharpWebStaticLib)' == ''">$(MSBuildThisFileDirectory)..\..\..\rust\pyxel-bind-cs\target\wasm32-unknown-emscripten\release\pyxel_bind_cs.a</PyxelSharpWebStaticLib>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default wasm link stubs out the marshal-ilgen runtime component,
         which is needed for the bool parameters in PyxelSharp's P/Invokes
         (mono asserts in stub_emit_marshal_ilgen without it) -->
    <_MonoComponent Include="marshal-ilgen" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\PyxelSharp\PyxelSharp.csproj" />
    <NativeFileReference Include="$(PyxelSharpWebStaticLib)" />
    <!-- Shared boot glue: JS stubs expected by pyxel-core + dotnet.js startup -->
    <Content Include="$(MSBuildThisFileDirectory)wwwroot\pyxel-boot.js" Link="wwwroot\pyxel-boot.js" />
    <!-- JS-callable MEMFS helpers used by pyxel-boot.js's asset preloading -->
    <Compile Include="$(MSBuildThisFileDirectory)PyxelWebHost.cs" Link="PyxelWebHost.cs" />
  </ItemGroup>

  <Target Name="EnsurePyxelSharpWebPrerequisites" BeforeTargets="Build">
    <Error Condition="'$(EmsdkRoot)' == ''"
           Text="EmsdkRoot is not set. Run tools/Build-Wasm.ps1, or set the EMSDK environment variable (emsdk_env)." />
    <Error Condition="!Exists('$(PyxelSharpWebStaticLib)')"
           Text="pyxel_bind_cs.a not found at $(PyxelSharpWebStaticLib). Run tools/Build-Wasm.ps1 to build and stage the Rust staticlib." />
  </Target>

</Project>
